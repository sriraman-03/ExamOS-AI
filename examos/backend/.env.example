# Copy this file to .env and fill in real values. Never commit .env.

# Required for real AI answers/quizzes. If left blank, ExamOS runs in
# DEMO MODE: it uses rule-based fallbacks so the whole app still works
# end-to-end for a demo without any API key or cost.
ANTHROPIC_API_KEY=

# Secret used to sign auth tokens. Generate any long random string.
JWT_SECRET=change-this-to-a-long-random-string

# SQLite file path (relative to backend/ working directory)
DATABASE_URL=sqlite:///./data/examos.db

# Where uploaded PDFs are stored
UPLOAD_DIR=./data/uploads

# Max upload size in MB
MAX_UPLOAD_MB=20

# CORS origin for the frontend dev server
FRONTEND_ORIGIN=http://localhost:5173
